{
  "name": "teleco",
  "version": "0.1.0",
  "description": "Telegram control plane for the OpenAI Codex CLI and app-server",
  "license": "MIT",
  "author": "Benedict Evert",
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaRed0401/teleco"
  },
  "keywords": [
    "telegram",
    "codex",
    "openai",
    "bot",
    "cli",
    "bridge"
  ],
  "type": "module",
  "bin": {
    "teleco": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "scripts/",
    "systemd/",
    "docs/homebrew-linux.md",
    ".env.example",
    "codex-versions.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs && node scripts/prepare-codex-linux-sandbox.mjs",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "package:homebrew": "node scripts/build-homebrew-release.mjs"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@openai/codex": "0.149.0",
    "@openai/codex-sdk": "0.149.0",
    "grammy": "^1.44.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "parakeet-coreml": "^2.2.0"
  }
}
